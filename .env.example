# External backend POST JSON mode
CHATBOT_API_BASE_URL=http://localhost:3001
CHATBOT_API_MODE=post_json
CHATBOT_API_CHAT_PATH=/chatbot
CHATBOT_API_TIMEOUT_MS=180000

# Client-side direct-to-backend API
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_API_CHAT_PATH=/chatbot
NEXT_PUBLIC_BACKEND_API_CHAT_AGENTS_PATH=/api/chat/agents
NEXT_PUBLIC_BACKEND_API_CHAT_RETRIEVAL_PATH=/api/chat/retrieval
NEXT_PUBLIC_BACKEND_API_CHAT_RETRIEVAL_AGENTS_PATH=/api/chat/retrieval_agents
NEXT_PUBLIC_BACKEND_API_CHAT_STRUCTURED_OUTPUT_PATH=/api/chat/structured_output
NEXT_PUBLIC_BACKEND_API_RETRIEVAL_INGEST_PATH=/api/retrieval/ingest
NEXT_PUBLIC_BACKEND_API_EXPERT_KNOWLEDGE_GENERATE_PATH=/api/expert_knowledge/generate
NEXT_PUBLIC_BACKEND_API_EXPERT_KNOWLEDGE_SYSTEM_PROMPT_GENERATE_PATH=/api/expert_knowledge/system_prompt/generate
